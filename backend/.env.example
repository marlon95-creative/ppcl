DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where new quote requests are emailed (staff inbox)
QUOTE_NOTIFY_EMAIL=quotes@example.com
DEFAULT_FROM_EMAIL=no-reply@example.com
# Production email (leave EMAIL_HOST empty in dev: emails print to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional PostgreSQL (SQLite is used if POSTGRES_DB is empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
